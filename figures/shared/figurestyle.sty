\ProvidesPackage{figurestyle}[2026/10/05 Plate style of the manuscript]
% The plates are ink drawings; the drawing shows the structure and text is bookkeeping. Every plate is 15.2 cm wide
% and is included at \linewidth, so all plates print at one scale.
% Type: labels 9pt (lab), notes 8pt (sub); smaller only inside dense marks: 7pt in small cells and graph nodes
% (dense), 6.5pt for digits in discs (digit). If one label on a plate cannot take its size, every label on that plate
% comes down to it (figure 6).
% A label sits on what it names, with air, never on a line or another label. Text under an object is centred on it;
% a row or corner title is left-aligned at the margin, a note in a right corner right-aligned. In-plate text is
% lowercase, without full stops or colons; the guide's part headings repeat the manuscript's part titles.
% The line vocabulary (weights, action styles, hidden contours, leaders, hatch) lives in primitives.tex.
\pdfinfoomitdate=1 \pdftrailerid{}   % no date or random ID in the PDF, so a rebuild reproduces it byte for byte
\RequirePackage{amsmath,amssymb}
\RequirePackage{tikz,pgfplots}
\usetikzlibrary{arrows.meta,calc}
\pgfplotsset{compat=1.18,
  every axis/.append style={font=\fontsize{8}{10}\selectfont,line width=.4pt,tick style={line width=.4pt,draw=PlateInk},
    axis line style={draw=PlateInk}}}   % plots in ink, with notes for tick labels

% ---- the palette. Ink first; a hue is spent only where it carries meaning. Hues are used pure, never darkened; a
% faded tint marks only an obscured element. White is the cladding and hydrogen; grey is ink thinned, for greyed-out
% objects only.
\definecolor{PlateInk}{HTML}{303438}       % ink: contours, text, hatching, and every action path
\definecolor{ColRed}{HTML}{D56860}         % oxygen on the water plates; the version points
\definecolor{ColBlue}{HTML}{397BA8}        % nitrogen, nothing else
\definecolor{ColTeal}{HTML}{4F9C97}        % the reference family and the orientation sphere; rubidium
\definecolor{ColGold}{HTML}{E0B84F}        % retained regions and marks; potassium
\colorlet{ColOxygen}{ColRed}\colorlet{ColNitrogen}{ColBlue}\colorlet{ColPotassium}{ColGold}\colorlet{ColRubidium}{ColTeal}

% ---- colour roles (the only places a hue is spent)
\colorlet{ColDot}{ColRed}                    % version points, and the rotations of T on the closing plate
\colorlet{ColDotHidden}{ColDot!45}           % a hidden version point, pale in a ghost outline
\colorlet{ColBand}{ColTeal!38}               % the reference family (core sheet) as a surface
\colorlet{ColSphere}{ColTeal}                % the orientation sphere of the closing plate
\colorlet{ColWall}{white}                    % the cladding of the solid
\colorlet{ColRetained}{ColGold}              % a retained region or mark: the cell's edges, the chain, the shear line
\colorlet{ColPatch}{ColRetained!50}          % a retained region as a surface: the reference cell, a base patch
\colorlet{ColDualA}{ColTeal}                 % a dual pair (two components of one object) on a plate with no core
\colorlet{ColDualB}{ColGold}                 %   sheet and no retained region (figure 2): teal and gold
% Actions carry no colour.  Line style says which: solid = t, dashed = u or tu, dotted = a starred operation (b, E*).

% ---- the plate
\tikzset{
  plate/.style={font=\fontsize{9}{11}\selectfont,line cap=round,line join=round,draw=PlateInk,text=PlateInk},
}

% ---- molecules. The pics in figures/data/molecules.tex draw with \molrodj (primitives.tex), \molatom and \mollabel,
% in angstrom; the enclosing pic scale sets the display scale. \molA..\molG are the labels of columns 1..7.
\newcommand\molresetlabels{\def\molA{1}\def\molB{2}\def\molC{3}\def\molD{4}\def\molE{5}\def\molF{6}\def\molG{7}}
\molresetlabels
\newcommand\mollabel[6]{}                    % no labels unless a plate asks for them (primitives.tex)
\tikzset{molarrow/.style={line width=.8pt,draw=PlateInk,-{Stealth[length=1.5mm,width=1.2mm]},shorten <=.4mm}}
\newcommand\molarrow[4]{\draw[molarrow] (#1,#2)--++(#3,#4);}

% ---- notation, the same macros as the manuscript preamble: arrays bold
\newcommand{\conf}{\mathcal{C}}
\newcommand{\spin}{\mathcal{H}_{\mathrm{spin}}}
\newcommand{\stat}{\chi_{\mathrm{stat}}}
\newcommand{\act}{\mathbin{\cdot}}
\newcommand{\X}{\mathbf{X}}                 % configuration matrix; \X_0 the reference
\newcommand{\Pmat}[1]{\mathbf{P}_{#1}}      % signed right-action matrix
\newcommand{\Rmat}{\mathbf{R}}              % rotation matrix
