\ProvidesPackage{figurestyle}[2026/10/03 Textbook ink figure style]
\RequirePackage{amsmath,amssymb}
\RequirePackage{tikz,pgfplots}
\usetikzlibrary{arrows.meta,calc,positioning,patterns,patterns.meta,decorations.pathreplacing,backgrounds}
\pgfplotsset{compat=1.18}

% ---- the palette, anchored on the cover plate (author decision, 2026-10-04) and LOCKED on 2026-10-04 after the grayscale
% study (studies/alternatives/round3/palette-grayscale.tex, gray/): these hex values are final; every plate draws from these alone.
% The plates are ink drawings first; a hue is spent only where it speeds comprehension or guides the eye.
\definecolor{PlateInk}{HTML}{303438}       % ink: contours, text, hatching, and every action path
\definecolor{ColRed}{HTML}{D56860}         % oxygen on the water plates; the version points on the methylamine plates
\definecolor{ColBlue}{HTML}{397BA8}        % nitrogen, nothing else
\definecolor{ColTeal}{HTML}{4F9C97}        % the reference family as a surface (pale tint); rubidium (full strength)
\definecolor{ColGold}{HTML}{E0B84F}        % retained regions (a packet, the reference cell, the one image); potassium
% White is the cladding and the hydrogen; grey is ink thinned.  Green and violet left the palette with this decision.
\providecommand\PaletteOverride{}\PaletteOverride   % a study may redefine the hues here, before the roles are derived
% Hues are used pure; a faded tint marks only an obscured element (a version point behind a wall). Never darken a hue.
\colorlet{ColOxygen}{ColRed}\colorlet{ColNitrogen}{ColBlue}\colorlet{ColPotassium}{ColGold}\colorlet{ColRubidium}{ColTeal}
\colorlet{ColGoldStroke}{ColGold}   % strokes keep the pure hue (author, 2026-10-04); gold strokes are drawn heavier instead

% ---- colour roles (the only places a hue is spent)
\colorlet{ColDot}{ColRed}                    % version points, packet centres
\colorlet{ColBand}{ColTeal!38}               % the reference family (core sheet) where it is a surface
\colorlet{ColBandLine}{ColTeal}              % the core sheet where it is cut (never darkened)
\colorlet{ColWall}{white}                    % the cladding of the solid
\colorlet{ColRetained}{ColGold}              % a retained region (the reference cell, the packets, the one image of F)
\colorlet{ColDualA}{ColTeal}                 % a dual pair (two components of one object) on a plate with no core
\colorlet{ColDualB}{ColGold}                 %   sheet and no retained region (figure 2): teal and gold
% Actions carry no colour.  Line style says which: solid = t, dashed = u or tu, dotted = a starred operation (b, E*).
% The styles tpath, upath, bpath and the lift styles live in primitives.tex.

% ---- the plate: ink lines only (grey is for greyed-out objects), labels 9pt (8pt minimum); the line styles live in primitives.tex
\tikzset{
  plate/.style={font=\fontsize{9}{11}\selectfont,line cap=round,line join=round,
    draw=PlateInk,text=PlateInk,>={Stealth[length=1.8mm,width=1.4mm]}},
}

% ---- molecule primitives.  Coordinates come from figures/data/molecules.tex in angstrom;
% the enclosing pic scale sets the display scale.  Disc sizes and fonts do not scale.
\tikzset{
  molbond/.style={line width=.65pt,draw=PlateInk},
  atomH/.style={circle,draw=PlateInk,fill=white,line width=.55pt,minimum size=3.8mm,
    inner sep=0pt,font=\fontsize{8}{9}\selectfont,text=PlateInk},
  atomC/.style={atomH,fill=PlateInk,text=white,minimum size=4.4mm},
  atomN/.style={atomH,fill=ColNitrogen,text=white,minimum size=4.4mm},
  atomO/.style={atomH,fill=ColOxygen,text=PlateInk,minimum size=4.4mm},
  atomK/.style={atomH,fill=ColPotassium,text=PlateInk,minimum size=4.8mm},
  atomRb/.style={atomH,fill=ColRubidium,text=PlateInk,minimum size=5.2mm},
  molarrow/.style={line width=.8pt,draw=PlateInk,-{Stealth[length=1.5mm,width=1.2mm]},shorten <=.4mm},
  minimol/.style={atomH/.append style={minimum size=2.0mm,line width=.4pt},
    atomC/.append style={minimum size=2.4mm},atomN/.append style={minimum size=2.4mm},
    atomO/.append style={minimum size=2.4mm},atomK/.append style={minimum size=2.4mm},
    atomRb/.append style={minimum size=2.6mm},molbond/.append style={line width=.45pt}},
}
\newif\ifmollabels \mollabelstrue
\def\molA{1}\def\molB{2}\def\molC{3}\def\molD{4}\def\molE{5}\def\molF{6}\def\molG{7}
\newcommand\molbond[4]{\draw[molbond] (#1,#2)--(#3,#4);}
\newcommand\molatom[4]{\node[atom#1] at (#3,#4) {\ifmollabels$\mathrm{#1}_{#2}$\fi};}
\newcommand\molarrow[4]{\draw[molarrow] (#1,#2)--++(#3,#4);}
% restore the identity labelling (used after relabelled versions)
\newcommand\molresetlabels{\def\molA{1}\def\molB{2}\def\molC{3}\def\molD{4}\def\molE{5}\def\molF{6}\def\molG{7}}

% ---- common text helpers
\newcommand{\conf}{\mathcal{C}}
\newcommand{\hilb}{\mathcal{H}}
\newcommand{\spin}{\mathcal{H}_{\mathrm{spin}}}
\newcommand{\stat}{\chi_{\mathrm{stat}}}
\newcommand{\act}{\mathbin{\cdot}}
\newcommand{\R}{\mathbb{R}}
% notation (approved 2026-10-04), the same macros as the manuscript preamble: arrays bold, operators sans serif
\newcommand{\X}{\mathbf{X}}                 % configuration matrix; \X_0 the reference
\newcommand{\Pmat}[1]{\mathbf{P}_{#1}}      % signed right-action matrix
\newcommand{\Rmat}{\mathbf{R}}              % rotation matrix
\newcommand{\Uop}[1]{\mathsf{U}_{#1}}       % spatial action operator
\newcommand{\Pproj}[1]{\mathsf{P}_{#1}}     % isotypic projector
\newcommand{\jdens}{j_\varphi}              % positive chart density
